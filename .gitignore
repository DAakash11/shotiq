# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Python backend
.venv/
__pycache__/
*.pyc

# Cached NBA responses are keyed by player and season, so browsing the app
# accumulates them locally. Only the default subject is committed, since it
# is the offline fallback that keeps the dashboard working when
# stats.nba.com is unreachable.
server/cache/*
!server/cache/shots-1628983-2025-26.json
!server/cache/splits-1628983-2025-26.json
# The generated summary ships too, so the AI panel works for anyone who
# clones this without an API key -- and so a hosted demo can serve it with
# SHOTIQ_SUMMARY_LIVE left off.
!server/cache/summary-1628983-2025-26.json

# Environment — never commit real keys
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
