{
  "name": "shotiq-worker",
  "private": true,
  "version": "0.1.0",
  "description": "Async job service that pre-warms ShotIQ's player-season cache.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "redis:dev": "docker run -d --name shotiq-redis -p 6379:6379 redis:alpine"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "bullmq": "^6.1.2",
    "fastify": "^5.12.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1"
  }
}
