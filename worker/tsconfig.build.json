{
  // The BUILD config: same rules, but it emits, and the tests do not ship.
  //
  // Two configs rather than one because the two jobs genuinely disagree.
  // Type-checking wants to see the tests -- they are the code most likely to
  // drift when a type changes. The build wants them gone, for the same
  // reason .dockerignore already excludes server/tests: a production image
  // that contains no test runner cannot accidentally run one.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false
  },
  // src/testing/ is excluded as well as the tests themselves, and not for
  // tidiness: noNetwork.ts imports vitest. Compiled into dist it would leave
  // the production image carrying a module that requires a devDependency the
  // runtime stage does not install. Nothing imports it at runtime, so it
  // would never actually throw -- which is exactly the sort of thing that
  // sits in an image unnoticed until someone wires it up by accident.
  "exclude": ["src/**/*.test.ts", "src/testing/**"]
}
