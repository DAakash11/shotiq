# Copy this file to server/.env and fill in the value.
#
#     cd server
#     copy .env.example .env
#
# .env is gitignored and must never be committed. If a key is ever pushed,
# revoke it in the provider console FIRST -- deleting the commit is not
# enough, because it survives in forks, clones, and GitHub's own caches.
#
# Note there is no VITE_ prefix anywhere here, and there must never be:
# Vite inlines VITE_* variables into the client bundle at build time, which
# would publish the key to every visitor. The key is read by the FastAPI
# server only, and the browser never sees it.


# A free key from https://aistudio.google.com/apikey -- no card required.
# Current keys are prefixed 'AQ.', not the older 'AIza'.
# Verify one without installing anything:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY"
GEMINI_API_KEY=

# Whether the API may call the LLM at all.
#
# Defaults to false when unset, so an unconfigured deployment serves only
# the summaries already committed to server/cache/ and can never spend
# quota. Set it to true locally when you want to generate a new one.
#
# Only the exact word 'true' enables it -- '1' and 'yes' do not, so a
# plausible-looking typo fails closed rather than switching on billing.
SHOTIQ_SUMMARY_LIVE=false

# Optional. The model is pinned in summary.py; override only to test a
# different one. Model ids go stale fast -- gemini-2.5-flash already 404s
# for new keys -- so list models before setting this.
# SHOTIQ_SUMMARY_MODEL=gemini-3.7-flash
